# Copy to .env. Never commit your .env or put this key in the React application.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional secret for direct API clients. The browser prompts for it when enabled.
ANALYSIS_API_KEY=
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=128
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_ANALYSES=3
FETCH_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=75
MAX_PAGES=3
MAX_HTML_BYTES=2000000
MAX_CONTENT_CHARS=24000
STATIC_DIRECTORY=frontend/dist
